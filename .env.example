# Copy to .env and adjust. .env is git-ignored. Never commit real secrets.

# --- Local PostgreSQL + PostGIS (docker compose) ---
POSTGRES_USER=pitad
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=pitad
POSTGRES_PORT=5432

# --- Local Redis (docker compose) ---
REDIS_PORT=6379

# --- API (used from Phase 2 onward) ---
# Keep in sync with the values above.
DATABASE_URL=postgresql://pitad:change-me-locally@localhost:5432/pitad
REDIS_URL=redis://localhost:6379